# Discord Application ID (Client ID)
# https://discord.com/developers/applications → your app → General Information → Application ID
DISCORD_CLIENT_ID=

# Local bridge HTTP port (Chrome extension POSTs page context here)
BRIDGE_PORT=3847

# Optional: Rich Presence art asset key from Developer Portal
# Rich Presence → Art Assets (upload image, use its name without extension)
DISCORD_LARGE_IMAGE_KEY=logo

# AnimeEnigma personal API key (ak_…) from profile settings
# Used for GET /api/users/me/activity/current + /stream (authoritative "now watching")
# https://animeenigma.org/api-docs/
ANIMEENIGMA_API_KEY=

# API origin (default production)
ANIMEENIGMA_API_BASE=https://animeenigma.org
